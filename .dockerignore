node_modules/
.env
*.log
.git/
.gitignore
README.md
.dockerignore
coverage/
.DS_Store
certbot/
nginx/*-rendered.conf
mobile/
# Host-only paths on the EC2 box (the build context there is the live
# /home/ubuntu tree). incoming/ and release-*.tar.gz are written by a
# concurrently queued deploy from the other repo while this one builds.
incoming/
releases/
release-*.tar.gz
archive/
avature-src/
*.tgz
*.tar.gz
*.bak
*.bak.*
stacks/
# Host-only state under /home/ubuntu that must never reach the image: it holds
# credentials (.ssh, .git-credentials, .env backups, docker config) or churns
# while the context is being sent (pm2 sockets, guard locks, npm cache).
.ssh/
.git-credentials
.bash_history
.docker/
.npm/
.cache/
.pm2/
.deploy.lock
.*.lock
.*-guard.*
.*_restore.*
.env.*
!.env.example
.sudo_as_admin_successful
