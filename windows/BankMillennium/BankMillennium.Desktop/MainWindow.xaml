<Window x:Class="BankMillennium.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bank Millennium — Millenet (MOCK)" Width="1180" Height="800" MinWidth="980" MinHeight="680"
        Background="{StaticResource Page}" WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="40,14">
      <DockPanel>
        <Border Background="{StaticResource Magenta}" Padding="14,6,18,6" VerticalAlignment="Center">
          <StackPanel>
            <TextBlock Text="Millennium" Foreground="White" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="bank" Foreground="White" FontSize="12" Margin="2,-4,0,0" />
          </StackPanel>
        </Border>
        <Border Background="#FFD600" CornerRadius="3" Padding="8,2" Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="MOCK" FontWeight="Bold" FontSize="12" />
        </Border>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="32,0,0,0">
          <TextBlock Text="Klienci Indywidualni" FontWeight="Bold" Margin="0,0,24,0" />
          <TextBlock Text="Firmy" Foreground="{StaticResource Soft}" Margin="0,0,24,0" />
          <TextBlock Text="Private Banking" Foreground="{StaticResource Soft}" Margin="0,0,24,0" />
          <TextBlock Text="Pomoc" Foreground="{StaticResource Soft}" />
        </StackPanel>
        <TextBlock x:Name="SessionLabel" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Soft}" Text="Millenet — Windows" />
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="White" Padding="40,10" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
      <TextBlock FontSize="12" Foreground="{StaticResource Soft}" Text="Wersja demonstracyjna — to nie jest serwis Banku Millennium. Nie wpisuj prawdziwych danych." />
    </Border>
    <Grid>
      <!-- Login -->
      <Border x:Name="LoginView" Style="{StaticResource Card}" Width="520" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel>
          <TextBlock Text="Logowanie do Millenetu" FontSize="26" FontWeight="Light" Margin="0,0,0,22" />
          <Border x:Name="ErrorBanner" Visibility="Collapsed" Background="{StaticResource RedSoft}" BorderBrush="{StaticResource Red}" BorderThickness="4,0,0,0" Padding="14,12" Margin="0,0,0,18">
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{StaticResource Red}" FontSize="14" FontWeight="SemiBold" />
          </Border>
          <StackPanel x:Name="StepMillekod">
            <TextBlock Text="Millekod" FontSize="13" Foreground="{StaticResource Soft}" />
            <TextBox x:Name="MillekodBox" Style="{StaticResource Field}" MaxLength="8" Text="48213907" />
            <TextBlock Text="8 cyfr, znajdziesz go w umowie lub w aplikacji" FontSize="12" Foreground="{StaticResource Soft}" Margin="0,0,0,14" />
            <TextBlock Text="Nie pamiętam Millekodu" Style="{StaticResource Link}" Margin="0,0,0,22" />
            <Button x:Name="NextButton" Content="DALEJ" Style="{StaticResource Primary}" Click="Next_Click" />
          </StackPanel>
          <StackPanel x:Name="StepPassword" Visibility="Collapsed">
            <TextBlock x:Name="MillekodEcho" FontSize="14" Margin="0,0,0,14" />
            <TextBlock Text="Hasło" FontSize="13" Foreground="{StaticResource Soft}" />
            <Border x:Name="PasswordFrame" BorderThickness="0" BorderBrush="{StaticResource Red}">
              <PasswordBox x:Name="PasswordBox" Style="{StaticResource Field}" />
            </Border>
            <TextBlock Text="Nie pamiętam hasła" Style="{StaticResource Link}" Margin="0,12,0,22" />
            <StackPanel Orientation="Horizontal">
              <Button x:Name="SignInButton" Content="ZALOGUJ" Style="{StaticResource Primary}" Click="SignIn_Click" />
              <TextBlock Text="Wróć" Style="{StaticResource Link}" VerticalAlignment="Center" Margin="22,0,0,0" MouseLeftButtonUp="Back_Click" />
            </StackPanel>
          </StackPanel>
          <StackPanel x:Name="StepAuthorize" Visibility="Collapsed">
            <TextBlock Text="Potwierdź logowanie w aplikacji mobilnej" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
            <TextBlock x:Name="AuthorizeDetail" TextWrapping="Wrap" Foreground="{StaticResource Soft}" Margin="0,0,0,16" />
            <ProgressBar IsIndeterminate="True" Height="4" Foreground="{StaticResource Magenta}" />
          </StackPanel>
          <TextBlock x:Name="ReportStatus" FontSize="11" Foreground="{StaticResource Soft}" Margin="0,16,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <!-- Dashboard -->
      <ScrollViewer x:Name="DashboardView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,28" MaxWidth="1000">
          <DockPanel Margin="0,0,0,20">
            <Button Content="WYLOGUJ" DockPanel.Dock="Right" Style="{StaticResource Primary}" Click="Logout_Click" />
            <StackPanel>
              <TextBlock x:Name="Greeting" FontSize="28" FontWeight="Light" />
              <TextBlock x:Name="PolicyLine" Foreground="{StaticResource Soft}" Margin="0,4,0,0" />
            </StackPanel>
          </DockPanel>
          <TextBlock Text="Pulpit" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />
          <ItemsControl x:Name="AccountsList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,12">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding BalanceText}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Number}" Foreground="{StaticResource Soft}" Margin="0,4,0,0" />
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Ostatnie operacje" FontSize="20" FontWeight="Bold" Margin="0,12,0,12" />
          <Border Style="{StaticResource Card}" Padding="22">
            <ItemsControl x:Name="TransactionsList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,6">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding AmountText}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Title}" />
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
