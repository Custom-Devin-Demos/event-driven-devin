<Application x:Class="BankMillennium.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Magenta" Color="#BD004F" />
    <SolidColorBrush x:Key="MagentaDark" Color="#9A0040" />
    <SolidColorBrush x:Key="Ink" Color="#2E2E2E" />
    <SolidColorBrush x:Key="Soft" Color="#737373" />
    <SolidColorBrush x:Key="Line" Color="#E6E6E6" />
    <SolidColorBrush x:Key="Page" Color="#F0F0F0" />
    <SolidColorBrush x:Key="Red" Color="#D0021B" />
    <SolidColorBrush x:Key="RedSoft" Color="#FDECEE" />
    <SolidColorBrush x:Key="Ok" Color="#1B7F3B" />
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Roboto, Segoe UI" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="32" />
    </Style>
    <Style x:Key="Field" TargetType="Control">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="BorderBrush" Value="#969696" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="Margin" Value="0,6,0,4" />
    </Style>
    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Magenta}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Padding" Value="28,11" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="Link" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Magenta}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="TextDecorations" Value="Underline" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </Application.Resources>
</Application>
