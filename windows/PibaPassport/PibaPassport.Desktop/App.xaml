<Application x:Class="PibaPassport.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Gov" Color="#0B3C7A" />
    <SolidColorBrush x:Key="Gov2" Color="#1A5BB5" />
    <SolidColorBrush x:Key="GovSoft" Color="#E8F0FB" />
    <SolidColorBrush x:Key="Line" Color="#D9DEE6" />
    <SolidColorBrush x:Key="Soft" Color="#5B6574" />
    <SolidColorBrush x:Key="Red" Color="#C8102E" />
    <SolidColorBrush x:Key="RedSoft" Color="#FDE8EB" />
    <SolidColorBrush x:Key="Ok" Color="#0E7A43" />
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="22" />
      <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource Gov}" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Gov2}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Padding" Value="24,10" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource Primary}">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="{StaticResource Gov2}" />
      <Setter Property="BorderBrush" Value="{StaticResource Gov2}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style x:Key="Choice" TargetType="ToggleButton">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="{StaticResource Gov2}" />
      <Setter Property="BorderBrush" Value="{StaticResource Gov2}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="Margin" Value="0,0,10,10" />
      <Setter Property="MinWidth" Value="170" />
      <Setter Property="Cursor" Value="Hand" />
      <Style.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Background" Value="{StaticResource Gov2}" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </Application.Resources>
</Application>
