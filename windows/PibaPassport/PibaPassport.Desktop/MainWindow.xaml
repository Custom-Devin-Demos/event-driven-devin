<Window x:Class="PibaPassport.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="רשות האוכלוסין וההגירה — זימון תור לדרכון ביומטרי"
        Width="1100" Height="800" MinWidth="900" MinHeight="640"
        FlowDirection="RightToLeft" FontFamily="Segoe UI" FontSize="14"
        Background="#F4F6F9" WindowStartupLocation="CenterScreen">
  <DockPanel>
    <!-- gov.il header -->
    <StackPanel DockPanel.Dock="Top">
      <Border Background="#222" Padding="4">
        <TextBlock Foreground="#DDD" FontSize="12" HorizontalAlignment="Center" Text="סביבת הדגמה — אינו אתר ממשלתי. נתונים לדוגמה בלבד." />
      </Border>
      <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,10">
        <StackPanel Orientation="Horizontal">
          <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource Gov}">
            <TextBlock Text="✡" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="gov.il" FlowDirection="LeftToRight" FontSize="24" FontWeight="ExtraBold" Foreground="{StaticResource Gov}" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
      <Border Background="{StaticResource Gov}" Padding="20,8">
        <TextBlock Text="רשות האוכלוסין וההגירה" Foreground="White" FontSize="15" />
      </Border>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="24,16,24,40" MaxWidth="1040">
        <TextBlock Text="זימון תור והגשת בקשה לדרכון או לתעודת זהות ביומטריים בעמדות שירות דיגיטליות" TextWrapping="Wrap" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Gov}" Margin="0,0,0,12" />

        <!-- stepper -->
        <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16">
          <UniformGrid Rows="1" x:Name="Stepper">
            <TextBlock x:Name="Step1" Padding="14,10" Text="1  בחירת שירות" />
            <TextBlock x:Name="Step2" Padding="14,10" Text="2  הזדהות" />
            <TextBlock x:Name="Step3" Padding="14,10" Text="3  בחירת לשכה ומועד" />
            <TextBlock x:Name="Step4" Padding="14,10" Text="4  תשלום אגרה ואישור התור" />
          </UniformGrid>
        </Border>

        <!-- 1. Service -->
        <StackPanel x:Name="ScreenInfo">
          <TextBlock TextWrapping="Wrap" FontSize="15" Margin="0,0,0,16" Text="כל הבקשות מוגשות בעמדות שירות דיגיטליות, הנמצאות בחלק מלשכות מינהל האוכלוסין. יש לקבוע תור ללשכה בה נמצאת עמדת השירות ולשלם את האגרה מראש." />
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="מהו סוג המסמך?" />
              <WrapPanel>
                <ToggleButton x:Name="DocIdCard" Style="{StaticResource Choice}" Content="תעודת זהות ביומטרית" Click="OnIdCard" />
                <ToggleButton x:Name="DocPassport" Style="{StaticResource Choice}" Content="דרכון ביומטרי" Click="OnPassport" />
              </WrapPanel>
              <TextBlock x:Name="IdCardNote" Visibility="Collapsed" Foreground="{StaticResource Soft}" Text="בסביבת ההדגמה זמין זימון תור לדרכון ביומטרי בלבד" />
              <StackPanel x:Name="PassportOptions" Visibility="Collapsed">
                <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,12,0,8" Text="מהי סיבת הבקשה?" />
                <WrapPanel>
                  <ToggleButton x:Name="ReasonFirst" Style="{StaticResource Choice}" Content="דרכון ראשון" Click="OnReason" Tag="First" />
                  <ToggleButton x:Name="ReasonRenewal" Style="{StaticResource Choice}" Content="חידוש דרכון שפג תוקפו" Click="OnReason" Tag="Renewal" />
                  <ToggleButton x:Name="ReasonLost" Style="{StaticResource Choice}" Content="דרכון שאבד, נגנב או הושחת" Click="OnReason" Tag="Lost" />
                </WrapPanel>
                <TextBlock FontSize="16" FontWeight="SemiBold" Margin="0,12,0,8" Text="גיל המבקש" />
                <WrapPanel>
                  <ToggleButton x:Name="AgeAdult" Style="{StaticResource Choice}" Content="מעל גיל 18" Click="OnAge" Tag="Adult" />
                  <ToggleButton x:Name="AgeMinor" Style="{StaticResource Choice}" Content="מתחת לגיל 18" Click="OnAge" Tag="Minor" />
                </WrapPanel>
                <Button x:Name="StartButton" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,12,0,0" IsEnabled="False" Content="לזימון תור והגשת בקשה" Click="OnStart" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="תעריפי אגרה לדרכון (בש&quot;ח, מעודכן ל-1.1.2026)" />
              <TextBlock TextWrapping="Wrap" Text="ראשון/חידוש, מעל 18: בלשכה 315 · קיץ אינטרנט 290 · חורף אינטרנט 185" />
              <TextBlock TextWrapping="Wrap" Text="אבד/נגנב/הושחת, מעל 18: בלשכה 645 · קיץ אינטרנט 620 · חורף אינטרנט 515" />
              <TextBlock TextWrapping="Wrap" Text="ראשון/חידוש, מתחת 18: בלשכה 165 · קיץ אינטרנט 145 · חורף אינטרנט 110" />
              <TextBlock TextWrapping="Wrap" Text="אבד/נגנב/הושחת, מתחת 18: בלשכה 330 · קיץ אינטרנט 310 · חורף אינטרנט 275" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- 2. National sign-in -->
        <Border x:Name="ScreenLogin" Style="{StaticResource Card}" Visibility="Collapsed" MaxWidth="460" HorizontalAlignment="Left">
          <StackPanel>
            <TextBlock Style="{StaticResource H2}" Text="הזדהות לאומית" />
            <TextBlock Foreground="{StaticResource Soft}" TextWrapping="Wrap" Text="הזדהות באמצעות מספר תעודת זהות וקוד חד-פעמי שנשלח לטלפון הנייד." />
            <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="מספר תעודת זהות" />
            <TextBox x:Name="IdNumber" Text="039584271" Padding="8" />
            <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="מספר טלפון נייד" />
            <TextBox Text="050-7341186" Padding="8" />
            <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="קוד חד-פעמי (SMS)" />
            <TextBox Text="482913" Padding="8" />
            <Button x:Name="LoginButton" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,16,0,0" Content="כניסה" Click="OnLogin" />
          </StackPanel>
        </Border>

        <!-- 3. Branch / date / slot -->
        <Grid x:Name="ScreenBranch" Visibility="Collapsed">
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="בחירת לשכה עם עמדת שירות דיגיטלית" />
              <StackPanel x:Name="BranchList" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource H2}" Text="בחירת מועד" />
              <TextBlock FontWeight="SemiBold" Margin="0,0,0,6" Text="תאריך" />
              <WrapPanel x:Name="DateList" />
              <TextBlock FontWeight="SemiBold" Margin="0,8,0,6" Text="שעה" />
              <WrapPanel x:Name="SlotList" />
              <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Style="{StaticResource Ghost}" Content="חזרה" Click="OnBranchBack" Margin="0,0,10,0" />
                <Button x:Name="BranchNext" Style="{StaticResource Primary}" Content="המשך לתשלום" IsEnabled="False" Click="OnBranchNext" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>

        <!-- 4. Payment -->
        <StackPanel x:Name="ScreenPay" Visibility="Collapsed">
          <Border x:Name="PayError" Visibility="Collapsed" Background="{StaticResource Red}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Foreground="White" FontSize="18" FontWeight="Bold" Text="✖  התשלום לא בוצע והתור לא נקבע" />
              <TextBlock Foreground="White" Text="אירעה תקלה בחישוב האגרה. לא חויבתם. אנא נסו שוב מאוחר יותר." />
              <TextBlock x:Name="PayErrorCode" Foreground="White" FontFamily="Consolas" Margin="0,6,0,0" FlowDirection="LeftToRight" HorizontalAlignment="Right" />
            </StackPanel>
          </Border>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="סיכום הבקשה" />
                <TextBlock x:Name="Summary" TextWrapping="Wrap" LineHeight="24" />
                <Border Background="{StaticResource GovSoft}" CornerRadius="6" Padding="14" Margin="0,12,0,0">
                  <DockPanel>
                    <TextBlock x:Name="FeeAmount" DockPanel.Dock="Right" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Gov}" />
                    <TextBlock x:Name="FeeLabel" VerticalAlignment="Center" FontSize="15" />
                  </DockPanel>
                </Border>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Style="{StaticResource H2}" Text="תשלום אגרה מקוון" />
                <TextBlock FontWeight="SemiBold" Margin="0,0,0,4" Text="מספר כרטיס אשראי" />
                <TextBox Text="4580 1234 5678 9012" Padding="8" FlowDirection="LeftToRight" />
                <TextBlock FontWeight="SemiBold" Margin="0,12,0,4" Text="תוקף / CVV" />
                <TextBox Text="09/28   123" Padding="8" FlowDirection="LeftToRight" MaxWidth="160" HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                  <Button Style="{StaticResource Ghost}" Content="חזרה" Click="OnPayBack" Margin="0,0,10,0" />
                  <Button x:Name="PayButton" Style="{StaticResource Primary}" Content="לתשלום ואישור התור" Click="OnPay" />
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>

        <!-- 5. Done -->
        <Border x:Name="ScreenDone" Style="{StaticResource Card}" Visibility="Collapsed">
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="✓" FontSize="48" Foreground="{StaticResource Ok}" HorizontalAlignment="Center" />
            <TextBlock Style="{StaticResource H2}" Foreground="{StaticResource Ok}" HorizontalAlignment="Center" Text="התור נקבע והאגרה שולמה בהצלחה" />
            <TextBlock x:Name="DoneText" HorizontalAlignment="Center" TextWrapping="Wrap" />
            <Button Style="{StaticResource Ghost}" Content="חזרה לדף השירות" Margin="0,16,0,0" HorizontalAlignment="Center" Click="OnDoneHome" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
