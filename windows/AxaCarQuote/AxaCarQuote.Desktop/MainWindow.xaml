<Window x:Class="AxaCarQuote.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AXA Car Insurance (MOCK)" Width="1180" Height="860" Background="White"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#FFD200" BorderBrush="#1A1A1A" BorderThickness="0,0,0,2" Padding="8">
      <TextBlock HorizontalAlignment="Center" FontSize="14" Foreground="#1A1A1A">
        <Run FontWeight="Bold" Text="THIS IS A MOCK" /><Run Text=" · AXA UK car insurance demo · Not affiliated with AXA UK or AXA Insurance UK plc · Do not enter real personal details." />
      </TextBlock>
    </Border>
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="40,10">
      <DockPanel>
        <Button x:Name="LogoButton" Click="Home_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="AXA home">
          <Grid Width="46" Height="46">
            <Rectangle Fill="{StaticResource Axa}" />
            <Polygon Fill="{StaticResource AxaRed}" Points="29,23 46,0 43.5,0 26.5,23" />
            <TextBlock Text="AXA" Foreground="White" FontFamily="Arial Black" FontWeight="Black" FontSize="16" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,3" />
          </Grid>
        </Button>
        <TextBlock x:Name="ReportStatus" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Soft}" Margin="16,0,0,0" />
        <StackPanel x:Name="TopNav" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="NavCar" Style="{StaticResource NavLink}" Content="CAR ▾" Click="Car_Click" />
          <Button Style="{StaticResource NavLink}" Content="HOME ▾" />
          <Button Style="{StaticResource NavLink}" Content="LANDLORD ▾" />
          <Button Style="{StaticResource NavLink}" Content="BUSINESS ▾" />
          <Button Style="{StaticResource NavLink}" Content="VAN ▾" />
          <Button Style="{StaticResource NavLink}" Content="HEALTH ▾" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Border x:Name="CarMenu" DockPanel.Dock="Top" Visibility="Collapsed" Background="{StaticResource Page}" Padding="40,14">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Car insurance:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
        <Button x:Name="MenuComprehensive" Style="{StaticResource NavLink}" Content="Comprehensive car insurance" Click="Comprehensive_Click" />
        <Button Style="{StaticResource NavLink}" Content="Third party, fire and theft" />
        <Button Style="{StaticResource NavLink}" Content="Electric car insurance" />
        <Button Style="{StaticResource NavLink}" Content="Get a quote" Click="Quote_Click" />
      </StackPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <Grid>
        <!-- Home -->
        <StackPanel x:Name="HomeView">
          <Border Height="300" Padding="60,0">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#1D2C44" Offset="0" /><GradientStop Color="#26354D" Offset="0.45" /><GradientStop Color="#000000" Offset="1" /></LinearGradientBrush>
            </Border.Background>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Width="460">
              <TextBlock Text="When different generations come together, we thrive" FontFamily="Georgia" FontSize="36" Foreground="White" TextAlignment="Right" />
            </StackPanel>
          </Border>
          <UniformGrid Columns="3" Margin="60,34,60,10">
            <StackPanel Margin="0,0,24,0"><TextBlock Text="Health Insurance" Style="{StaticResource Heading}" FontSize="24" /><TextBlock Foreground="{StaticResource Soft}" Text="Get access to the care you need, when you need it." Margin="0,0,0,14" /><Button Style="{StaticResource Ghost}" Content="MORE ABOUT HEALTH" /></StackPanel>
            <StackPanel Margin="0,0,24,0"><TextBlock Text="Car Insurance" Style="{StaticResource Heading}" FontSize="24" /><TextBlock Foreground="{StaticResource Soft}" Text="Comprehensive cover with a lifetime guarantee on repairs made by our approved repairers." Margin="0,0,0,14" />
              <StackPanel Orientation="Horizontal"><Button x:Name="HomeCarQuote" Style="{StaticResource Primary}" Content="GET A QUOTE" Click="Quote_Click" /><Button x:Name="HomeCarMore" Style="{StaticResource Ghost}" Content="MORE ABOUT CAR" Click="Comprehensive_Click" /></StackPanel></StackPanel>
            <StackPanel><TextBlock Text="Home Insurance" Style="{StaticResource Heading}" FontSize="24" /><TextBlock Foreground="{StaticResource Soft}" Text="Buildings and contents cover from AXA." Margin="0,0,0,14" /><Button Style="{StaticResource Ghost}" Content="MORE ABOUT HOME" /></StackPanel>
          </UniformGrid>
          <Border Background="{StaticResource Page}" Padding="60,28" Margin="0,24,0,0">
            <StackPanel><TextBlock Text="Insurance quotes from AXA UK" Style="{StaticResource Heading}" FontSize="26" />
              <WrapPanel><Button x:Name="ListComprehensive" Style="{StaticResource Ghost}" Content="COMPREHENSIVE CAR INSURANCE ›" Click="Comprehensive_Click" Margin="0,0,12,12" /><Button Style="{StaticResource Ghost}" Content="HOME INSURANCE ›" Margin="0,0,12,12" /><Button Style="{StaticResource Ghost}" Content="VAN INSURANCE ›" Margin="0,0,12,12" /><Button Style="{StaticResource Ghost}" Content="HEALTH INSURANCE ›" Margin="0,0,12,12" /></WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Comprehensive car insurance -->
        <StackPanel x:Name="ComprehensiveView" Visibility="Collapsed">
          <Border Background="#FAFAFA" Padding="60,10"><TextBlock FontSize="14"><Hyperlink Click="Home_Click">Home page</Hyperlink> / Car insurance / Types of car insurance cover / Comprehensive car insurance</TextBlock></Border>
          <Border Padding="60,36">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#DFE7EE" Offset="0" /><GradientStop Color="#8D7F72" Offset="0.75" /><GradientStop Color="#4B4038" Offset="1" /></LinearGradientBrush></Border.Background>
            <Border Background="White" Width="480" HorizontalAlignment="Left" Padding="40">
              <StackPanel>
                <TextBlock Text="Comprehensive Car Insurance Cover with AXA" Style="{StaticResource Heading}" FontSize="34" />
                <TextBlock Text="Trust you're in safe hands with AXA's comprehensive car insurance cover" FontWeight="Bold" FontSize="16" Margin="0,0,0,18" />
                <StackPanel Orientation="Horizontal"><Button x:Name="CompGetQuote" Style="{StaticResource Primary}" Content="GET A QUOTE →" Click="Quote_Click" /><Button Style="{StaticResource Ghost}" Content="RETRIEVE A QUOTE" /></StackPanel>
                <TextBlock Margin="0,18,0,0" Text="✓ Uninsured drivers promise" />
                <TextBlock Text="✓ Lifetime guarantee on car repairs made by our approved repairers" />
                <TextBlock Text="✓ 99.7% of all car insurance claims paid out" />
                <TextBlock Text="✓ Make and track claims online" />
              </StackPanel>
            </Border>
          </Border>
          <StackPanel Margin="60,30">
            <TextBlock Text="AXA Car Insurance or AXA Plus?" Style="{StaticResource Heading}" FontSize="26" />
            <TextBlock Foreground="{StaticResource Soft}" Text="Both include theft, fire and accidental damage, damage to other people's cars or property, lifetime guarantee on repairs and child car-seat cover. AXA Plus adds a courtesy car, motor legal protection and protected no claims discount." />
          </StackPanel>
        </StackPanel>

        <!-- Quote wizard -->
        <Grid x:Name="QuoteView" Visibility="Collapsed" Margin="60,24,60,40">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Name="StepIndicator" Text="1. Your car  ›  2. About you  ›  3. Your cover  ›  4. Your quote" FontWeight="Bold" Foreground="{StaticResource Axa}" Margin="0,0,0,18" />
            <StackPanel x:Name="Step1">
              <TextBlock Text="Let's find your car" Style="{StaticResource Heading}" />
              <TextBlock Text="Car registration" Style="{StaticResource Label}" />
              <StackPanel Orientation="Horizontal">
                <TextBox x:Name="RegBox" Text="LK24 EVX" Style="{StaticResource Field}" Width="220" Background="#FFD200" FontWeight="Bold" FontSize="22" CharacterCasing="Upper" Margin="0,0,12,0" />
                <Button x:Name="FindCarButton" Style="{StaticResource Primary}" Content="FIND CAR" Click="FindCar_Click" />
              </StackPanel>
              <TextBlock x:Name="RegError" Foreground="{StaticResource Red}" FontWeight="Bold" Visibility="Collapsed" Margin="0,6,0,0" />
              <Border x:Name="VehicleCard" Visibility="Collapsed" BorderBrush="{StaticResource Axa}" BorderThickness="1" Background="#F3F3FF" Padding="16" Margin="0,14,0,0" Width="480" HorizontalAlignment="Left">
                <TextBlock x:Name="VehicleText" FontSize="15" />
              </Border>
              <StackPanel Orientation="Horizontal" Margin="0,26,0,0"><Button Style="{StaticResource Ghost}" Content="BACK" Click="Comprehensive_Click" /><Button x:Name="ToStep2" Style="{StaticResource Primary}" Content="CONTINUE →" Click="ToStep2_Click" /></StackPanel>
            </StackPanel>
            <StackPanel x:Name="Step2" Visibility="Collapsed">
              <TextBlock Text="About you" Style="{StaticResource Heading}" />
              <TextBlock Text="First name" Style="{StaticResource Label}" /><TextBox x:Name="FirstNameBox" Text="James" Style="{StaticResource Field}" />
              <TextBlock Text="Last name" Style="{StaticResource Label}" /><TextBox x:Name="LastNameBox" Text="Carter" Style="{StaticResource Field}" />
              <TextBlock Text="Date of birth (DD/MM/YYYY)" Style="{StaticResource Label}" /><TextBox x:Name="DobBox" Text="14/03/1986" Style="{StaticResource Field}" />
              <TextBlock Text="Postcode" Style="{StaticResource Label}" /><TextBox x:Name="PostcodeBox" Text="M20 2LS" Style="{StaticResource Field}" />
              <TextBlock Text="Years of no claims discount" Style="{StaticResource Label}" />
              <ComboBox x:Name="NcdBox" Style="{StaticResource Field}" Width="120" SelectedIndex="7"><ComboBoxItem>0</ComboBoxItem><ComboBoxItem>1</ComboBoxItem><ComboBoxItem>2</ComboBoxItem><ComboBoxItem>3</ComboBoxItem><ComboBoxItem>4</ComboBoxItem><ComboBoxItem>5</ComboBoxItem><ComboBoxItem>6</ComboBoxItem><ComboBoxItem>7</ComboBoxItem><ComboBoxItem>8</ComboBoxItem><ComboBoxItem>9</ComboBoxItem></ComboBox>
              <TextBlock x:Name="DriverError" Foreground="{StaticResource Red}" FontWeight="Bold" Visibility="Collapsed" Margin="0,10,0,0" />
              <StackPanel Orientation="Horizontal" Margin="0,26,0,0"><Button Style="{StaticResource Ghost}" Content="BACK" Click="ToStep1_Click" /><Button x:Name="ToStep3" Style="{StaticResource Primary}" Content="CONTINUE →" Click="ToStep3_Click" /></StackPanel>
            </StackPanel>
            <StackPanel x:Name="Step3" Visibility="Collapsed">
              <TextBlock Text="Your cover" Style="{StaticResource Heading}" />
              <TextBlock Text="Level of cover" Style="{StaticResource Label}" />
              <RadioButton x:Name="CoverComprehensive" Content="Comprehensive" IsChecked="True" FontSize="16" Margin="0,4" />
              <RadioButton x:Name="CoverTpft" Content="Third party, fire and theft" FontSize="16" Margin="0,4" />
              <TextBlock Text="Estimated annual mileage" Style="{StaticResource Label}" />
              <ComboBox Style="{StaticResource Field}" Width="160" SelectedIndex="1"><ComboBoxItem>5,000</ComboBoxItem><ComboBoxItem>8,000</ComboBoxItem><ComboBoxItem>12,000</ComboBoxItem></ComboBox>
              <StackPanel Orientation="Horizontal" Margin="0,26,0,0"><Button Style="{StaticResource Ghost}" Content="BACK" Click="ToStep2_Click" /><Button x:Name="GetQuoteButton" Style="{StaticResource Primary}" Content="GET MY QUOTE →" Click="GetQuote_Click" /></StackPanel>
            </StackPanel>
            <StackPanel x:Name="Step4" Visibility="Collapsed">
              <Border x:Name="QuoteErrorBanner" Visibility="Collapsed" Background="{StaticResource RedSoft}" BorderBrush="{StaticResource Red}" BorderThickness="6,0,0,0" Padding="22">
                <StackPanel>
                  <TextBlock Text="Sorry, we can't give you a quote online right now" Foreground="{StaticResource Red}" FontWeight="Bold" FontSize="22" />
                  <TextBlock Text="Something went wrong while we were working out your price. Please try again later or call us on 0330 024 1199." Margin="0,6,0,6" />
                  <TextBlock x:Name="QuoteErrorRef" FontFamily="Consolas" FontSize="14" Foreground="#6B0F20" />
                </StackPanel>
              </Border>
              <StackPanel x:Name="QuoteResult" Visibility="Collapsed">
                <TextBlock x:Name="QuoteTitle" Style="{StaticResource Heading}" />
                <TextBlock x:Name="QuoteSub" Foreground="{StaticResource Soft}" Margin="0,0,0,16" />
                <UniformGrid Columns="2">
                  <Border BorderBrush="{StaticResource Line}" BorderThickness="2" Padding="22" Margin="0,0,12,0"><StackPanel><TextBlock Text="AXA Car Insurance" FontWeight="Bold" FontSize="20" Foreground="{StaticResource Axa}" /><TextBlock x:Name="PriceStd" FontSize="36" FontWeight="Bold" Foreground="{StaticResource Axa}" /><TextBlock x:Name="MonthlyStd" Foreground="{StaticResource Soft}" /></StackPanel></Border>
                  <Border BorderBrush="{StaticResource Axa}" BorderThickness="2" Padding="22"><StackPanel><TextBlock Text="AXA Plus Car Insurance" FontWeight="Bold" FontSize="20" Foreground="{StaticResource Axa}" /><TextBlock x:Name="PricePlus" FontSize="36" FontWeight="Bold" Foreground="{StaticResource Axa}" /><TextBlock x:Name="MonthlyPlus" Foreground="{StaticResource Soft}" /></StackPanel></Border>
                </UniformGrid>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,26,0,0"><Button Style="{StaticResource Ghost}" Content="BACK" Click="ToStep3_Click" /><Button Style="{StaticResource Ghost}" Content="BACK TO CAR INSURANCE" Click="Comprehensive_Click" /></StackPanel>
            </StackPanel>
          </StackPanel>
          <Border Grid.Column="1" Background="{StaticResource Page}" Padding="20" VerticalAlignment="Top" Margin="24,0,0,0">
            <StackPanel>
              <TextBlock Text="Your details" FontWeight="Bold" FontSize="18" />
              <TextBlock Text="Car" Foreground="{StaticResource Soft}" Margin="0,10,0,0" /><TextBlock x:Name="SummaryCar" Text="Not found yet" FontWeight="Bold" />
              <TextBlock Text="Main driver" Foreground="{StaticResource Soft}" Margin="0,10,0,0" /><TextBlock x:Name="SummaryDriver" Text="—" FontWeight="Bold" />
              <TextBlock FontSize="12" Foreground="{StaticResource Soft}" Margin="0,18,0,0" Text="Demo hint: LK24 EVX is the seeded customer car. MA21 PTR and YD19 DSL quote normally." />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</Window>
