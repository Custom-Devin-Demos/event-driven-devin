<settings>
  <!-- Maven Central rate-limits shared build hosts (HTTP 429); Google's mirror serves the same artifacts. -->
  <mirrors>
    <mirror>
      <id>google-central</id>
      <url>https://maven-central.storage-download.googleapis.com/maven2/</url>
      <mirrorOf>central</mirrorOf>
    </mirror>
  </mirrors>
</settings>
