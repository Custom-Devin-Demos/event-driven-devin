{
  "display_information": {
    "name": "Field CTO Reservations",
    "description": "Reserve a block of a Field CTO's time; admins approve.",
    "background_color": "#1f2937"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": false,
      "messages_tab_read_only_enabled": true
    },
    "bot_user": {
      "display_name": "Field CTO Reservations",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/fcto",
        "url": "https://devindemos.com/slack/fcto/commands",
        "description": "Reserve a Field CTO or see who is booked",
        "usage_hint": "request | schedule [next|month|@person|me] | roster | help",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "chat:write.public",
        "commands",
        "files:write",
        "im:write",
        "users:read",
        "users:read.email"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://devindemos.com/slack/fcto/events",
      "bot_events": ["app_home_opened"]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://devindemos.com/slack/fcto/interactions"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
