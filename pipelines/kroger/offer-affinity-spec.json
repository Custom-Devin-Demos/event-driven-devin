{
  "specVersion": "2026.01",
  "owner": "84.51-personalization",
  "description": "Category-affinity encoding spec for the Kroger storefront offer ranker. Each shopper segment is encoded as a dense vector over the offer category vocabulary. Weights are the 12-month basket-share index for the segment, normalized to [0,1] and rounded to 2dp by the feature build.",
  "featureView": "offer_affinity_by_segment",
  "trainingWindow": "2025-01-01/2025-12-31",
  "categoryVocabulary": [
    "dairy",
    "produce",
    "grocery",
    "meat",
    "bakery",
    "household"
  ],
  "membershipTiers": {
    "none": "standard",
    "boost-monthly": "boost_monthly",
    "boost-annual": "boost_annual"
  },
  "segments": {
    "standard": {
      "source": "basket_history_12mo",
      "cohortSize": 4183220,
      "weights": {
        "dairy": 0.42,
        "produce": 0.55,
        "grocery": 0.61,
        "meat": 0.38,
        "bakery": 0.29,
        "household": 0.47
      }
    },
    "boost_monthly": {
      "source": "basket_history_12mo",
      "cohortSize": 918447,
      "weights": {
        "dairy": 0.88,
        "produce": 0.91,
        "grocery": 0.64,
        "meat": 0.83,
        "bakery": 0.51,
        "household": 0.36
      }
    }
  }
}
