# Session creation verification
# When set, session-creating endpoints require this secret in x-session-secret header
# SESSION_SECRET=your-session-secret

# Internal slow-query patrol guardrails
INTERNAL_JOB_RATE_WINDOW_MS=60000
INTERNAL_JOB_PER_IP_RATE_LIMIT=4
INTERNAL_JOB_PROCESS_RATE_LIMIT=6

# Load Generator
LOADGEN_TARGET_URL=http://localhost:3000
# How often (ms) the synthetic traffic cycle runs. Higher = less traffic = fewer spans.
# 60000 = 1 cycle/min, 120000 = 1 cycle/2min. Intervals below roughly 45000
# can silently drop internal-job telemetry against the default per-IP limit;
# raise both knobs together before choosing a faster cycle. Default: 120000
LOADGEN_INTERVAL_MS=120000

# ─── Migration Control Tower (/migration) ───
# GitHub PAT with read access to COG-GTM/abinitio-retail-dwh and
# COG-GTM/modern-data-platform; the entrypoint clones/refreshes both into the
# migration-repos volume at container start (required unless pre-mounted)
# GITHUB_PAT=
# 4-digit access code gating the dashboard and API (empty = no gate)
# MIGRATION_ACCESS_CODE=
# Auto Slack alert + Devin session on failing staging runs (set false to disable)
MIGRATION_AUTO_DISPATCH=true
MIGRATION_TOWER_URL=https://devindemos.com/migration
# Branches of the two demo repos to run parity against
MIGRATION_MDP_REF=main
MIGRATION_LEGACY_REF=main
# Slack channel for parity-regression alerts (uses SLACK_BOT_TOKEN above)
# SLACK_MIGRATION_CHANNEL_ID=
# Devin remediation dispatch (falls back to DEVIN_SERVICE_KEY / DEVIN_ORG_ID)
# DEVIN_SERVICE_KEY_MIGRATION=
# DEVIN_PLAYBOOK_ID_MIGRATION=

# ─── Incident Lab (/oncall/incident-lab) ───
# Token required by the presenter control endpoints (X-Lab-Token header)
# INCIDENT_LAB_TOKEN=
# Slack user IDs (comma-separated) invited into the incident channel once the
# persona layer joins it — e.g. the presenter who armed the run
# INCIDENT_LAB_INVITE_USER_IDS=
# Datadog incident declaration reuses DD_API_KEY + DD_INCIDENT_APP_KEY /
# DD_APPLICATION_KEY above; Slack personas use INCIDENT_LAB_SLACK_BOT_TOKEN
# if set (e.g. the SRE bot's token, which already carries the needed scopes),
# falling back to SLACK_BOT_TOKEN. Required scopes: channels:read,
# channels:join, chat:write, chat:write.customize, channels:write.invites
# for INCIDENT_LAB_INVITE_USER_IDS, and channels:history for the dynamic
# responder
# INCIDENT_LAB_SLACK_BOT_TOKEN=
# OpenAI key enabling the in-character dynamic persona responder (optional)
# OPENAI_API_KEY=
# Warehouse (Supabase) that arming re-seeds for scenarios declaring a
# warehouse.seedFile; falls back to SUPABASE_WAREHOUSE_URL. Point it at the
# session pooler from an IPv4-only host — db.<ref>.supabase.co is IPv6-only.
# Unset simply skips seeding (reported on the run log)
# INCIDENT_LAB_WAREHOUSE_URL=
# Token used to sweep the investigator's fix branches/PRs off the subject repo
# at arm and stop. Prefer a dedicated token scoped to that repo only — the
# sweep closes PRs and deletes refs, and it falls back to the broad
# GITHUB_TOKEN when this is unset. Unset both to disable the sweep
# INCIDENT_LAB_GITHUB_TOKEN=
# Control-endpoint throttle (defaults: 20 mutations per 60000ms window)
# INCIDENT_LAB_MUTATION_LIMIT=
# INCIDENT_LAB_MUTATION_WINDOW_MS=
# Where the active run is persisted so it survives restarts/deploys
# (default: data/incident-lab-run.json, on the volume-mounted data dir)
# INCIDENT_LAB_STATE_FILE=
