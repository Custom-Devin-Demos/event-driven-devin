     this.remove();
    },
    add: function(batch) {
     var match = false;
     this.collection.each(function (m) {
      if (m.get('hash') === batch.get('hash')) {
       m.set('qty', parseInt(m.get('qty')) + parseInt(batch.get('qty')));
       m.set('total', m.get('qty') * m.get('price'));
       match = true;
      }
     }, this);
     if (!match) {
      this.collection.add(batch);
     }
    }
   });

