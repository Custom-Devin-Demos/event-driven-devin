    initialize : function(){
    },
    fetch: function(productId, productType, callback) {
     var coll = this;
     this.invokeContainerLoadingCtx($('.deskLayout'), 'fetchCompositeProducts', productId, productType, function(response){
      coll.reset(response.data);
      callback();
     }, {escape : false});
    }
   });

   CCRZ.views.aggregateView = CCRZ.CloudCrazeView.extend({
    //CCRZ-2026
    templatePhone : CCRZ.util.template(CCRZ.uiProperties.aggregateView.phone.tmpl),
    templateDesktop : CCRZ.util.template(CCRZ.uiProperties.aggregateView.desktop.tmpl),
    aggTemplateDesktop : CCRZ.util.template(CCRZ.uiProperties.aggregateView.desktop.aggContent.tmpl),
    mainImageContentDesktop : CCRZ.util.template(CCRZ.uiProperties.aggregateView.desktop.mainImageContentDesktop.tmpl),
    aggTemplatePhone : CCRZ.util.template(CCRZ.uiProperties.aggregateView.phone.aggContent.tmpl),
    aggTPTemplate : CCRZ.util.template(CCRZ.uiProperties.aggregateView.desktop.aggTP.tmpl),
    managedSubView : true,
    firstRender : true,
    viewName : "aggregateView",
    events: {
     "change .aggSelection" : "switchProduct"
    },

    init: function() {
     var v = this;
     this.dataSet = new CCRZ.collections.CompositeList();
     //CCRZ-2026
     Handlebars.registerPartial("mainContentDesktop", $(CCRZ.uiProperties.aggregateView.partials.mainContentDesktop).html());
     if(!CCRZ.disableAdaptive) {
      Handlebars.registerPartial("mainContentPhone", $(CCRZ.uiProperties.aggregateView.partials.mainContentPhone).html());
     }else{
      Handlebars.registerPartial("mainImageContentDesktop", $(CCRZ.uiProperties.aggregateView.partials.mainImageContentDesktop).html());
      Handlebars.registerPartial("aggTP", $(CCRZ.uiProperties.aggregateView.partials.aggTP).html());
     }
    },
    processData: function(prodData) {
     var v = this;
     if(v.firstRender){
      v.firstRender = false;
      v.dataSet.fetch(prodData.id, prodData.ProductType, function() {
      var parent = new CCRZ.models.CompositeModel();
      parent.set({
       inventoryType: CCRZ.productDetailModel.attributes.inventoryType,
       mediaWrappers: CCRZ.productDetailModel.attributes.mediaWrappers,
       numberOfReviews: CCRZ.productDetailModel.attributes.numberOfReviews,
       product: CCRZ.productDetailModel.attributes.product,
       totalReviews: CCRZ.productDetailModel.attributes.totalReviews,
       uid: CCRZ.productDetailModel.attributes.uid,
       isTierPriced: CCRZ.productDetailModel.attributes.isTierPriced,
       displayPrice: CCRZ.productDetailModel.attributes.displayPrice
      });
      for(var i=0; i < v.dataSet.length; i++) {
       var rP = v.dataSet.models[i].attributes;
       if(!rP.product.mediaWrapper) {
        rP.product.mediaWrapper = parent.attributes.product.mediaWrapper;
       }
       if(!_.isEmpty(rP.pricingTiers) && !_.isEmpty(rP.pricingTiers.tiers)){
        //Parse and create the pricing tier objects we need to display
        var previousTier = null;
        var tierList = [];

        _.each(rP.pricingTiers.tiers, function(currentTier) {
         currentTier.pId = rP.product.prodBean.id;
         currentTier.selClass = 'cc_prt_tier_box_unselected';
         currentTier.uoml = rP.product.prodBean.unitOfMeasureLabel;
         if(!_.isEmpty(previousTier)){
          previousTier.max = currentTier.q - 1;
         }
         tierList.push(currentTier);
         previousTier = currentTier;
        });

        if(!_.isEmpty(tierList)){
         rP.tiersList = tierList;
        }
       }
      }
      if (v.dataSet.length > 0) {
       var sortedArray = _.sortBy(v.dataSet.models, function(item){
        return item.attributes.product.price;
       });
       parent.set({
        minPrice: sortedArray[0].attributes.product.price,
        maxPrice: sortedArray[sortedArray.length-1].attributes.product.price
       });
      }
      v.dataSet.unshift(parent);
      v.render();
      v.renderSelectedProduct(v.dataSet.models[0].id);
     });
     }else{
      v.render();
      v.renderSelectedProduct(v.dataSet.models[0].id);
     }

    },
    renderDesktop : function() {
     var v = this;
     v.setElement($(".prodDetailContainer .aggSection"));
     v.$el.html(v.templateDesktop(this.dataSet.toJSON()));
    },
    renderPhone : function() {
     var v = this;
      v.setElement($(".phone_center_column .aggSection"));
      v.$el.html(v.templatePhone(this.dataSet.toJSON()));
    },
    updateTiersSelection : function(selId){
     var p = $('.gp_quantity_block').find(".entry");
     var qtyVal = parseInt(p.val());

     var tierList = $('.cc_prt_sel');
     if(!_.isEmpty(tierList)){
      var cc_price = $('.cc_aggPriceValue')[0];
      var price = (null != cc_price && null != cc_price.dataset && null != cc_price.dataset.prc)?cc_price.dataset.prc:0;
      $('.cc_prt_sel').removeClass('cc_prt_tier_box_selected bg-info').addClass('cc_prt_tier_box_unselected');
      _.each(tierList, function(currentTier) {
       if(parseFloat(currentTier.dataset.qty) <= parseFloat(qtyVal) && ((currentTier.dataset.max === null || currentTier.dataset.max === undefined) || currentTier.dataset.max.trim().length === 0 || parseFloat(currentTier.dataset.max) >= parseFloat(qtyVal))){
        $('.cc_prt_sel_'+currentTier.dataset.qty).removeClass('cc_prt_tier_box_unselected').addClass('cc_prt_tier_box_selected bg-info');
        price = currentTier.dataset.prc;
       }
      });
      $('.cc_aggPriceValue').html(formatPrice(price));
     }
    },
    renderSelectedProduct: function(selId) {
     var selAgg = this.dataSet.get(selId);

     if(selAgg.attributes.product.prodBean.SKU){
         $(".wishFinder").attr("data-sku", selAgg.attributes.product.prodBean.SKU);
     }

     if(selAgg.attributes.product.prodBean.shortDesc){
         $(".shortDesc").html("<br/>"+selAgg.attributes.product.prodBean.shortDesc);
     }else{
      $(".shortDesc").html("<br/>");
     }
     if (CCRZ.display.isPhone()) {
      $(".phone_center_column .pd_content").html(this.aggTemplatePhone(selAgg.toJSON()));
      if (selAgg.attributes.product.canAddtoCart) {
       $(".phone_center_column .btn.btn-primary.addItem").attr("data-sku", selAgg.attributes.product.prodBean.sku);
       $(".phone_center_column .addSection").show();
      }
      else
       $(".phone_center_column .addSection").hide();
     }
     else {
      $(".prodDetailContainer .pd_content").html(this.aggTemplateDesktop(selAgg.toJSON()));
      $(".prodDetailContainer .prt_content").html(this.aggTPTemplate(selAgg.toJSON()));
      if (CCRZ.disableAdaptive) {
       $(".prodDetailContainer .pd_img_content").html(this.mainImageContentDesktop(selAgg.toJSON()));
      }

      if (selAgg.attributes.product.canAddtoCart) {
       if (CCRZ.disableAdaptive) {
        $(".prodDetailContainer .btn.btn-default.addItem").attr("data-sku", selAgg.attributes.product.prodBean.sku);
        // .hide is deprecated in b3 and show() has no effect because of !important on .hidden. they suggest using add/remove
        $(".prodDetailContainer .addSection").removeClass('hidden')
       } else {
        $(".prodDetailContainer .btn.btn-primary.addItem").attr("data-sku", selAgg.attributes.product.prodBean.sku);
        $(".prodDetailContainer .addSection").show();
       }
      }
      else {
       if (CCRZ.disableAdaptive) {
        // .hide is deprecated in b3 and show() has no effect because of !important on .hidden. they suggest using add/remove
        $(".prodDetailContainer .addSection").addClass('hidden');
       } else {
        $(".prodDetailContainer .addSection").hide();
       }
      }

     }
     CCRZ.productDetailModel.set(selAgg.toJSON());
     this.updateTiersSelection(selId);
     //this.remote.unloadOverlay();
    },
    switchProduct: function(event) {
     var id = $("select.aggSelection option:selected").val();
     this.renderSelectedProduct(id);
    }
   });

   CCRZ.aggregateView = new CCRZ.views.aggregateView();
   CCRZ.aggregateView.listenTo(CCRZ.pubSub, 'prodDetailRefresh', function(inData) {
    CCRZ.aggregateView.processData(inData);
   });

  });

 </script></span>
