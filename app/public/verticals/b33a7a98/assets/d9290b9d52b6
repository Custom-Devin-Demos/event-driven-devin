                    jQuery('.timer-value.minutes').html(minutes.toString().padStart(2, '0'));
                    jQuery('.timer-value.seconds').html(seconds.toString().padStart(2, '0'));

                    // If the count down is finished, write some text
                    if (distance < 0) {
                        clearInterval(x);
