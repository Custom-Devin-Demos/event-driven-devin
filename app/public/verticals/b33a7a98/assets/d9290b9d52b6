        Handlebars.registerHelper('contains', function(haystack, needle, options) {
            if(typeof haystack !== 'undefined'){
                needle = needle.toLowerCase();
                haystack = haystack.toLowerCase();
            }

            needle = Handlebars.escapeExpression(needle);
